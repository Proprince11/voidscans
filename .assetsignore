# Files in the repo that should NOT be served as static assets.
# Cloudflare Workers Static Assets respects this file.
# See: https://developers.cloudflare.com/workers/static-assets/binding/

# Git
.git/
.gitignore

# Server-only directories
scripts/
workers/
docs/

# Top-level non-asset files
*.md
LICENSE
package.json
package-lock.json
yarn.lock
.dev.vars*
.env*
service-account.json
backups/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
node_modules/
